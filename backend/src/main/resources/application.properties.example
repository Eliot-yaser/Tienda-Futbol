# Rey del Balon - EVA3
# Copiar este archivo como application.properties
# Configurar DB_USER y DB_PASSWORD en el equipo local.

spring.application.name=backend
server.port=8080

spring.datasource.url=jdbc:mysql://localhost:3306/rey_del_balon
spring.datasource.username=${DB_USER:root}
spring.datasource.password=${DB_PASSWORD}
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# No modificar automaticamente las tablas
spring.jpa.hibernate.ddl-auto=none
spring.jpa.show-sql=false
